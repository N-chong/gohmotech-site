# Copy to /home/gohmotech/.config/gohmotech/beta.env and chmod 600.
# This file is read by config.beta; never put real credentials in this example.
BETA_SECRET_KEY=
BETA_ALLOWED_HOSTS=gohmotech.site,www.gohmotech.site
BETA_DB_NAME=gohmotech_beta
BETA_DB_USER=gohmotech_beta
BETA_DB_PASSWORD=
BETA_DB_HOST=127.0.0.1
BETA_DB_PORT=3306
BETA_DATA_ROOT=/home/gohmotech/.local/share/gohmotech-beta
BETA_REDIS_URL=redis://127.0.0.1:6379/2
BETA_CELERY_BROKER_URL=redis://127.0.0.1:6379/3
BETA_IOT_DEVICE_API_KEY=replace-with-a-long-random-device-only-key

# Required for public email signup/verification and password resets.
BETA_EMAIL_HOST=
BETA_EMAIL_PORT=587
BETA_EMAIL_USER=
BETA_EMAIL_PASSWORD=
BETA_FROM_EMAIL=
# Keep mandatory after SMTP is verified. Use none only for a controlled beta
# while email delivery is being repaired.
BETA_EMAIL_VERIFICATION=mandatory

# Optional Google login; authorize the HTTPS callback for the chosen hostname.
BETA_GOOGLE_CLIENT_ID=
BETA_GOOGLE_CLIENT_SECRET=
