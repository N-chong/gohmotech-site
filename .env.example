# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Google OAuth 2.0 / OpenID Connect
# Local callback: http://127.0.0.1:8000/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Use mandatory in production after SMTP is configured; development can use none.
ACCOUNT_EMAIL_VERIFICATION=none

# Supabase Database Configuration
# Get these from your Supabase project settings -> Database
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432

# Supabase API Configuration
# Get these from your Supabase project settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MQTT Configuration (for IoT devices)
MQTT_BROKER=your-mqtt-broker.com
MQTT_PORT=1883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
IOT_DEVICE_API_KEY=replace-with-a-long-random-device-only-key

# Email Configuration (for notifications)
EMAIL_ENABLED=False
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
ADMIN_EMAIL=admin@example.com

# SMS Configuration (Optional - requires Twilio)
SMS_ENABLED=False
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
ADMIN_PHONE_NUMBER=+1234567890

# Semaphore SMS Gateway (Philippines) — used by the `sms` app
# SMS_BACKEND: 'console' (dev/test, no credits used) or 'semaphore' (live).
# Keep the API key out of source control — set it here only, never in code.
SMS_BACKEND=console
SEMAPHORE_API_KEY=your-semaphore-api-key
SEMAPHORE_SENDER_NAME=
# Endpoints have sensible defaults; override only if Semaphore changes them.
# SEMAPHORE_API_URL=https://api.semaphore.co/api/v4/messages
# SEMAPHORE_ACCOUNT_URL=https://api.semaphore.co/api/v4/account

# Redis Configuration (for Celery and Channels)
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0

# Marketplace reservation hold after seller acceptance (hours)
MARKETPLACE_RESERVATION_HOLD_HOURS=72

# ML Model Configuration
ML_MODEL_PATH=static/models/goat_detector.h5
CONFIDENCE_THRESHOLD=0.5
NMS_IOU_THRESHOLD=0.45
USE_GPU=False
